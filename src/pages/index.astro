---
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="wrap">
    <header class="top">
      <div>
        <button class="city" id="city" type="button">广州 <span class="caret">▾</span></button>
        <div class="city-sub" id="status">正在定位…</div>
      </div>
      <div style="display:flex;gap:8px;flex:none">
        <button class="theme-btn" id="theme-btn" type="button" aria-label="切换深色模式">🌙</button>
        <button class="refresh" id="refresh" type="button">
          <span id="refresh-icon">⟳</span> 刷新
        </button>
      </div>
    </header>

    <section class="track-banner" id="track-banner" hidden>
      <div class="track-banner-head">
        <span>追踪 <b id="track-line"></b> · <span id="track-station"></span></span>
        <button class="track-end" id="track-end" type="button">结束</button>
      </div>
      <div class="track-big" id="track-big"></div>
      <div class="track-sub" id="track-sub"></div>
    </section>

    <div class="search">
      <span class="search-ico">🔍</span>
      <input id="search" type="search" placeholder="搜线路、车站" autocomplete="off" />
      <button class="search-btn" id="search-btn" type="button">搜索</button>
    </div>

    <section class="favs" id="favs" hidden>
      <div class="sec-title"><span>收藏</span></div>
      <div class="favs-row" id="favs-row"></div>
    </section>

    <div class="sec-title"><span>附近</span></div>

    <div class="list" id="list">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>

    <p class="msg" id="msg"></p>

    <section class="city-search" id="city-search" hidden>
      <div class="sec-title"><span>全城搜索</span></div>
      <div class="list" id="city-list"></div>
      <p class="msg" id="city-msg"></p>
    </section>

    <p class="foot">
      数据来自车来了 H5 接口 · 每 30 秒自动刷新<br />
      点站点名看该站全部线路，点线路看沿途站点 · 收藏与追踪只存在本机
    </p>
  </main>

  <script>
    import { esc, hhmm, fmtDist, lineRow, lineHref, stationHref, getJSON } from "../scripts/util.js";
    import { getFavs, isFavStation, toggleStation, toggleLine, onFavChange } from "../scripts/favs.js";
    import { nearestBus, getTrackedTrip, clearTrackedTrip } from "../scripts/watch.js";
    import { getCity, setCity, openCityPicker, cityCenter } from "../scripts/city.js";
    import { applyTheme, toggleTheme } from "../scripts/theme.js";

    let city = getCity();

    const els = {
      list: document.getElementById("list"),
      msg: document.getElementById("msg"),
      status: document.getElementById("status"),
      city: document.getElementById("city"),
      refresh: document.getElementById("refresh"),
      icon: document.getElementById("refresh-icon"),
      favs: document.getElementById("favs"),
      favsRow: document.getElementById("favs-row"),
      search: document.getElementById("search"),
      searchBtn: document.getElementById("search-btn"),
      citySearch: document.getElementById("city-search"),
      cityList: document.getElementById("city-list"),
      cityMsg: document.getElementById("city-msg"),
      banner: document.getElementById("track-banner"),
      trackLine: document.getElementById("track-line"),
      trackStation: document.getElementById("track-station"),
      trackBig: document.getElementById("track-big"),
      trackSub: document.getElementById("track-sub"),
      trackEnd: document.getElementById("track-end"),
      themeBtn: document.getElementById("theme-btn"),
    };

    const FALLBACK_GZ = { lat: 23.142166, lng: 113.316086, label: "体育西路（默认位置）" };

    let state = { lat: null, lng: null, busy: false };
    let lastUpdated = 0;
    let nearbyData = null;
    let trackedTrip = getTrackedTrip();

    const ETA_CACHE = "cl-st-eta-v1";

    function readEtaCache(id) {
      try {
        const c = JSON.parse(localStorage.getItem(ETA_CACHE) || "{}");
        const hit = c[id];
        if (hit && Date.now() - hit.t < 25_000) return hit.eta;
      } catch {
        /* ignore */
      }
      return null;
    }

    function writeEtaCache(id, eta) {
      try {
        const c = JSON.parse(localStorage.getItem(ETA_CACHE) || "{}");
        c[id] = { t: Date.now(), eta };
        localStorage.setItem(ETA_CACHE, JSON.stringify(c));
      } catch {
        /* ignore */
      }
    }

    /** 站点里所有线路中最早的一班（秒），没有就 -1 */
    function soonestEta(data) {
      let best = -1;
      for (const l of data.station?.lines || []) {
        const e = l.buses?.[0]?.eta;
        if (typeof e === "number" && e >= 0 && (best < 0 || e < best)) best = e;
      }
      return best;
    }

    async function stationEta(s) {
      const cached = readEtaCache(s.id);
      if (cached !== null) return cached;
      try {
        const q = new URLSearchParams({
          physicalStId: s.physicalStId || "",
          sId: s.sId || s.id,
          namesakeStId: s.namesakeStId || "",
          firstLineId: s.firstLineId || "",
          cityId: s.cityId || "040",
        });
        const data = await getJSON(`/api/station?${q}`);
        const eta = soonestEta(data);
        writeEtaCache(s.id, eta);
        return eta;
      } catch {
        return -1;
      }
    }

    /** 收藏线路的参照站与方向（id 形如 lineId#dir） */
    function lineIdDir(l) {
      const [lineId, dirTail] = String(l.id || "").split("#");
      return { lineId, dir: String(l.dir ?? dirTail ?? "1") };
    }

    /** 一条线路里最早的一班（秒），没有就 -1 */
    function soonestLineEta(data) {
      let best = -1;
      for (const b of data.buses || []) {
        if (typeof b.eta === "number" && b.eta >= 0 && (best < 0 || b.eta < best)) best = b.eta;
      }
      return best;
    }

    async function lineEta(l) {
      // 没有参照站时上游会拿别的站当目标， ETA 不可信，宁可不显示
      if (!l.stationId) return -1;
      const key = `L:${l.id}`;
      const cached = readEtaCache(key);
      if (cached !== null) return cached;
      const { lineId, dir } = lineIdDir(l);
      if (!lineId) return -1;
      try {
        const q = new URLSearchParams({
          lineId,
          dir,
          cityId: l.cityId || "040",
          stationId: l.stationId,
        });
        const data = await getJSON(`/api/line?${q}`);
        const eta = data.line?.targetMatched ? soonestLineEta(data) : -1;
        writeEtaCache(key, eta);
        return eta;
      } catch {
        return -1;
      }
    }

    function etaRight(eta) {
      if (typeof eta !== "number" || eta < 0) return "";
      if (eta < 60) {
        return `<span class="fav-min arrived">到站了</span><span class="fav-left">快去上车</span>`;
      }
      return `<span class="fav-min">${Math.max(1, Math.round(eta / 60))} 分钟</span>`;
    }

    function favStationRow(s, eta) {
      const q = new URLSearchParams({
        physicalStId: s.physicalStId || "",
        sId: s.sId || s.id,
        namesakeStId: s.namesakeStId || "",
        firstLineId: s.firstLineId || "",
        cityId: s.cityId || "040",
        n: s.name,
      });
      return `<a class="fav-row" href="/station/?${q}">
        <span class="fav-pill">🚏 ${esc(s.name)}</span>
        <span class="fav-mid"><b>${esc(s.name)}</b><i>收藏的站点 · 点进查看全部线路</i></span>
        <span class="fav-eta">${etaRight(eta)}</span>
      </a>`;
    }

    function favLineRow(l, eta) {
      const q = new URLSearchParams({
        lineId: String(l.id || "").split("#")[0],
        dir: String(l.dir ?? 1),
        cityId: l.cityId || "040",
        stationId: l.stationId || "",
        st: l.st || "",
        n: l.name,
      });
      const mid = l.st ? `${l.st}上车` : `开往 ${l.to || ""}`;
      return `<a class="fav-row" href="/line/?${q}">
        <span class="fav-pill">${esc(l.name)}</span>
        <span class="fav-mid"><b>${esc(mid)}</b><i>开往 ${esc(l.to || "—")}</i></span>
        <span class="fav-eta">${etaRight(eta)}</span>
      </a>`;
    }

    function drawFavs(favs, etaMap) {
      const items = [
        ...favs.lines.map((l) => favLineRow(l, etaMap ? etaMap.get(`L:${l.id}`) : undefined)),
        ...favs.stations.map((s) => favStationRow(s, etaMap ? etaMap.get(s.id) : undefined)),
      ];
      els.favs.hidden = items.length === 0;
      els.favsRow.innerHTML = items.join("");
    }

    async function hydrateFavEtas(favs) {
      const stations = favs.stations.slice(0, 6);
      const lines = favs.lines.slice(0, 4);
      if (!stations.length && !lines.length) return;
      const [stEtas, lnEtas] = await Promise.all([
        Promise.all(stations.map((s) => stationEta(s))),
        Promise.all(lines.map((l) => lineEta(l))),
      ]);
      const map = new Map();
      stations.forEach((s, i) => map.set(s.id, stEtas[i]));
      lines.forEach((l, i) => map.set(`L:${l.id}`, lnEtas[i]));
      drawFavs(getFavs(), map);
    }

    function renderFavs() {
      const favs = getFavs();
      drawFavs(favs);
      hydrateFavEtas(favs);
    }

    function stationCard(st) {
      const lines = st.lines
        .map((l) => lineRow(l, { station: st, cityId: city.id }))
        .join("");
      return `
        <section class="station">
          <div class="st-head">
            <a class="st-name" href="${stationHref(st, city.id)}">${esc(st.name)}${st.subway ? '<span class="sub">地铁</span>' : ""}</a>
            <div class="st-right">
              <span class="st-dist">${st.distance >= 0 ? fmtDist(st.distance) : ""}</span>
              <button class="fav${isFavStation(st.sId) ? " on" : ""}" type="button"
                data-fav-station="${esc(st.sId)}" data-st-name="${esc(st.name)}"
                data-st-physical="${esc(st.physicalStId)}" data-st-namesake="${esc(st.namesakeStId)}"
                data-st-first-line="${esc(st.firstLineId)}" aria-label="收藏站点">${isFavStation(st.sId) ? "★" : "☆"}</button>
            </div>
          </div>
          ${lines}
        </section>`;
    }

    function renderList(stations) {
      els.list.innerHTML = stations.map(stationCard).join("");
      bindButtons();
    }

    function render(data) {
      nearbyData = data;
      els.city.innerHTML = `${esc(city.name)} <span class="caret">▾</span>`;
      els.status.textContent = `更新于 ${hhmm(data.updatedAt)} · 每 30 秒自动刷新`;
      applySearch();
      els.msg.textContent = "";
    }

    function applySearch() {
      if (!nearbyData) return;
      // 大小写不敏感：用户手机键盘常打出小写 b1，线路号是大写 B1，
      // 不折小写就搜不到，显示“没有匹配”——截图实证。
      const q = els.search.value.trim().toLowerCase();
      if (!q) {
        renderList(nearbyData.stations || []);
        els.msg.textContent = "";
        els.citySearch.hidden = true;
        els.cityList.innerHTML = "";
        els.cityMsg.textContent = "";
        return;
      }
      const hit = (nearbyData.stations || [])
        .map((st) => {
          // 站名命中则整站保留；只命中线路时卡片里只留命中的线路，
          // 否则搜 B1 会整站留下、133/136/209 全在，看着像没过滤。
          const nameHit = String(st.name || "").toLowerCase().includes(q);
          const lines = nameHit
            ? st.lines || []
            : (st.lines || []).filter((l) => String(l.no || "").toLowerCase().includes(q));
          return lines.length ? { ...st, lines } : null;
        })
        .filter(Boolean);
      renderList(hit);
      els.msg.textContent = hit.length ? "" : "没有匹配的站点或线路";
      els.msg.className = "msg";
    }

    function runSearch() {
      applySearch();
      loadCitySearch(els.search.value);
      els.search.blur();
      els.list.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // 全城搜索：只在点「搜索」/回车时调一次上游，不随输入逐字调。
    // 附近搜不到的线路（如 B20）在这里出现，点进行线路页/站点页。
    let citySearchSeq = 0;
    async function loadCitySearch(q) {
      const query = (q || "").trim();
      if (!query) {
        els.citySearch.hidden = true;
        els.cityList.innerHTML = "";
        els.cityMsg.textContent = "";
        return;
      }
      const seq = ++citySearchSeq;
      els.citySearch.hidden = false;
      els.cityList.innerHTML = `<div class="skeleton"></div>`;
      els.cityMsg.textContent = "";
      try {
        const data = await getJSON(`/api/search?cityId=${city.id}&q=${encodeURIComponent(query)}`);
        if (seq !== citySearchSeq) return;
        const lines = (data.lines || [])
          .map(
            (l) => `<div class="line-wrap"><a class="line" href="${lineHref(l, null, city.id)}">
              <span class="badge">${esc(l.no)}</span>
              <span class="dir"><span class="to">${esc(l.from)} → ${esc(l.to)}</span>
              <span class="meta">全城线路 · 点进看沿途站点</span></span>
            </a></div>`,
          )
          .join("");
        const stations = (data.stations || [])
          .map(
            (s) => `<div class="line-wrap"><a class="line" href="${stationHref(s, city.id)}">
              <span class="badge">站</span>
              <span class="dir"><span class="to">${esc(s.name)}</span>
              <span class="meta">全城站点 · 点进看全部线路</span></span>
            </a></div>`,
          )
          .join("");
        els.cityList.innerHTML = lines + stations;
        els.cityMsg.textContent =
          lines || stations ? "" : "全城也没有匹配的线路或站点";
      } catch {
        if (seq !== citySearchSeq) return;
        els.cityList.innerHTML = "";
        els.cityMsg.textContent = "全城搜索暂不可用，稍后再试";
      }
    }

    function bindButtons() {      els.list.querySelectorAll("[data-fav-station]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const data = toggleStation({
            id: btn.dataset.favStation,
            name: btn.dataset.stName,
            sId: btn.dataset.favStation,
            physicalStId: btn.dataset.stPhysical,
            namesakeStId: btn.dataset.stNamesake,
            firstLineId: btn.dataset.stFirstLine,
            cityId: city.id,
          });
          const on = data.stations.some((s) => s.id === btn.dataset.favStation);
          btn.textContent = on ? "★" : "☆";
          btn.classList.toggle("on", on);
        });
      });
      els.list.querySelectorAll("[data-fav-line]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const data = toggleLine({
            id: btn.dataset.favLine,
            name: btn.dataset.lineName,
            to: btn.dataset.lineTo,
            dir: Number(btn.dataset.lineDir || 0),
            cityId: btn.dataset.lineCity || city.id,
            stationId: btn.dataset.lineStation || "",
            st: btn.dataset.lineStName || "",
          });
          const on = data.lines.some((l) => l.id === btn.dataset.favLine);
          btn.textContent = on ? "★" : "☆";
          btn.classList.toggle("on", on);
        });
      });
    }

    async function load({ silent = false } = {}) {
      if (state.busy || state.lat == null) return;
      state.busy = true;
      if (!silent) {
        els.refresh.disabled = true;
        els.icon.style.animation = "spin 900ms linear infinite";
      }
      try {
        const q = new URLSearchParams({
          lat: String(state.lat),
          lng: String(state.lng),
          cityId: city.id,
          limit: "8",
        });
        const data = await getJSON(`/api/nearby?${q}`);
        if (data.empty || !data.stations?.length) {
          els.list.innerHTML = "";
          els.msg.textContent = data.message || "附近没有查到线路，换个位置试试。";
        } else {
          render(data);
        }
        lastUpdated = Date.now();
      } catch (err) {
        els.msg.textContent = `查询失败：${err.message}`;
        els.msg.className = "msg err";
      } finally {
        state.busy = false;
        els.refresh.disabled = false;
        els.icon.style.animation = "";
      }
    }

    /** 切城市：存选择、更新城市名、附近/搜索按新城市重拉 */
    function applyCity() {
      setCity(city.id, city.name);
      els.city.innerHTML = `${esc(city.name)} <span class="caret">▾</span>`;
      els.citySearch.hidden = true;
      els.cityList.innerHTML = "";
      els.cityMsg.textContent = "";
      els.search.value = "";
      locate();
      loadBanner();
    }

    els.city.addEventListener("click", () => {
      openCityPicker((c) => {
        if (c.id === city.id) return;
        city = c;
        applyCity();
      });
    });

    function locate() {
      // 附近站点不等定位：先用默认位置立即加载，拿到真实位置后再按需刷新
      // 默认位置 = 所选城市市中心（热门城市有快照），拿不到定位时附近仍可用
      const fb = cityCenter(city.id) || FALLBACK_GZ;
      els.status.textContent = "正在定位…";
      state.lat = fb.lat;
      state.lng = fb.lng;
      load();
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const moved =
            Math.abs(pos.coords.latitude - state.lat) > 0.002 ||
            Math.abs(pos.coords.longitude - state.lng) > 0.002;
          state.lat = pos.coords.latitude;
          state.lng = pos.coords.longitude;
          if (moved) load({ silent: true });
        },
        () => {
          /* 保持默认位置 */
        },
        { timeout: 8000, maximumAge: 60_000 },
      );
    }

    // ── 首页追踪横幅 ──
    function paintBanner(trip, data) {
      els.trackLine.textContent = trip.lineNo || "";
      els.trackStation.textContent = trip.stationName || "";
      if (!data) {
        els.trackBig.textContent = "查询失败";
        els.trackBig.classList.add("arrived");
        els.trackSub.textContent = "";
        return;
      }
      const bus = nearestBus(data);
      const order = data.line?.targetOrder || 0;
      if (!bus) {
        els.trackBig.textContent = "暂无车辆";
        els.trackBig.classList.add("arrived");
        els.trackSub.textContent = `全线 ${data.buses.length} 辆车在途`;
        return;
      }
      els.trackBig.classList.remove("arrived");
      if (bus.eta < 60) {
        els.trackBig.textContent = "到站了";
        els.trackBig.classList.add("arrived");
        els.trackSub.textContent = "快去上车";
      } else {
        els.trackBig.innerHTML = `${Math.max(1, Math.round(bus.eta / 60))}<span class="track-unit">分钟</span>`;
        const left = order && bus.order ? order - bus.order : 0;
        els.trackSub.textContent = left > 0 ? `还有 ${left} 站` : "";
      }
    }

    async function loadBanner() {
      if (!trackedTrip) {
        els.banner.hidden = true;
        return;
      }
      els.banner.hidden = false;
      try {
        const q = new URLSearchParams({
          lineId: trackedTrip.lineId,
          dir: String(trackedTrip.dir),
          cityId: trackedTrip.cityId || "040",
          stationId: trackedTrip.stationId,
        });
        paintBanner(trackedTrip, await getJSON(`/api/line?${q}`));
      } catch {
        paintBanner(trackedTrip, null);
      }
    }

    els.trackEnd.addEventListener("click", () => {
      clearTrackedTrip();
      trackedTrip = null;
      els.banner.hidden = true;
    });

    els.refresh.addEventListener("click", () => load());
    els.themeBtn.addEventListener("click", toggleTheme);
    applyTheme();
    els.city.innerHTML = `${esc(city.name)} <span class="caret">▾</span>`;
    els.search.addEventListener("input", applySearch);
    els.searchBtn.addEventListener("click", runSearch);
    els.search.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter") {
        ev.preventDefault();
        runSearch();
      }
    });
    onFavChange(renderFavs);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        renderFavs();
        loadBanner();
        if (Date.now() - lastUpdated > 20_000) load({ silent: true });
      }
    });

    renderFavs();
    locate();
    loadBanner();
    setInterval(() => {
      if (document.visibilityState === "visible") {
        load({ silent: true });
        loadBanner();
      }
    }, 30_000);
  </script>
</Base>
