---
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="wrap">
    <header class="top">
      <div>
        <div class="city" id="city">附近站点</div>
        <div class="city-sub" id="status">正在定位…</div>
      </div>
      <button class="refresh" id="refresh" type="button">
        <span id="refresh-icon">⟳</span> 刷新
      </button>
    </header>

    <section class="favs" id="favs" hidden>
      <div class="favs-title">收藏</div>
      <div class="favs-row" id="favs-row"></div>
    </section>

    <div class="list" id="list">
      <div class="skeleton"></div>
      <div class="skeleton"></div>
      <div class="skeleton"></div>
    </div>

    <p class="msg" id="msg"></p>

    <p class="foot">
      数据来自车来了 H5 接口 · 每 30 秒自动刷新<br />
      点站点名看该站全部线路，点线路看沿途站点 · 收藏只存在本机
    </p>
  </main>

  <script>
    import { esc, hhmm, fmtDist, lineRow, stationHref, getJSON } from "../scripts/util.js";
    import { getFavs, isFavStation, toggleStation, toggleLine, onFavChange } from "../scripts/favs.js";

    const els = {
      list: document.getElementById("list"),
      msg: document.getElementById("msg"),
      status: document.getElementById("status"),
      city: document.getElementById("city"),
      refresh: document.getElementById("refresh"),
      icon: document.getElementById("refresh-icon"),
      favs: document.getElementById("favs"),
      favsRow: document.getElementById("favs-row"),
    };

    const FALLBACK = { lat: 23.142166, lng: 113.316086, label: "体育西路（默认位置）" };
    const CITY = "040";

    let state = { lat: null, lng: null, busy: false };
    let lastUpdated = 0;

    function renderFavs() {
      const favs = getFavs();
      const items = [
        ...favs.stations.map((s) => {
          const q = new URLSearchParams({
            physicalStId: s.physicalStId || "",
            sId: s.sId || s.id,
            namesakeStId: s.namesakeStId || "",
            firstLineId: s.firstLineId || "",
            cityId: s.cityId || CITY,
            n: s.name,
          });
          return `<a class="chip fav-station" href="/station/?${q}">🚏 ${esc(s.name)}</a>`;
        }),
        ...favs.lines.map((l) => {
          const q = new URLSearchParams({
            lineId: String(l.id || "").split("#")[0],
            dir: String(l.dir ?? 1),
            cityId: l.cityId || CITY,
            stationId: l.stationId || "",
            n: l.name,
          });
          return `<a class="chip fav-line" href="/line/?${q}">🚌 ${esc(l.name)} → ${esc(l.to || "")}</a>`;
        }),
      ];
      els.favs.hidden = items.length === 0;
      els.favsRow.innerHTML = items.join("");
    }

    function stationCard(st) {
      const lines = st.lines
        .map((l) => lineRow(l, { station: st, cityId: CITY }))
        .join("");
      return `
        <section class="station">
          <div class="st-head">
            <a class="st-name" href="${stationHref(st, CITY)}">${esc(st.name)}${st.subway ? '<span class="sub">地铁</span>' : ""}</a>
            <div class="st-right">
              <span class="st-dist">${st.distance >= 0 ? fmtDist(st.distance) : ""}</span>
              <button class="fav${isFavStation(st.sId) ? " on" : ""}" type="button"
                data-fav-station="${esc(st.sId)}" data-st-name="${esc(st.name)}"
                data-st-physical="${esc(st.physicalStId)}" data-st-namesake="${esc(st.namesakeStId)}"
                data-st-first-line="${esc(st.firstLineId)}" aria-label="收藏站点">${isFavStation(st.sId) ? "★" : "☆"}</button>
            </div>
          </div>
          ${lines}
        </section>`;
    }

    function render(data) {
      els.city.textContent = data.city || "附近站点";
      els.status.textContent = `更新于 ${hhmm(data.updatedAt)} · 每 30 秒自动刷新`;
      els.list.innerHTML = data.stations.map(stationCard).join("");
      els.msg.textContent = "";
      bindButtons();
    }

    function bindButtons() {
      els.list.querySelectorAll("[data-fav-station]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const data = toggleStation({
            id: btn.dataset.favStation,
            name: btn.dataset.stName,
            sId: btn.dataset.favStation,
            physicalStId: btn.dataset.stPhysical,
            namesakeStId: btn.dataset.stNamesake,
            firstLineId: btn.dataset.stFirstLine,
            cityId: CITY,
          });
          const on = data.stations.some((s) => s.id === btn.dataset.favStation);
          btn.textContent = on ? "★" : "☆";
          btn.classList.toggle("on", on);
        });
      });
      els.list.querySelectorAll("[data-fav-line]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const data = toggleLine({
            id: btn.dataset.favLine,
            name: btn.dataset.lineName,
            to: btn.dataset.lineTo,
            dir: Number(btn.dataset.lineDir || 0),
            cityId: btn.dataset.lineCity || CITY,
            stationId: btn.dataset.lineStation || "",
          });
          const on = data.lines.some((l) => l.id === btn.dataset.favLine);
          btn.textContent = on ? "★" : "☆";
          btn.classList.toggle("on", on);
        });
      });
    }

    async function load({ silent = false } = {}) {
      if (state.busy || state.lat == null) return;
      state.busy = true;
      if (!silent) {
        els.refresh.disabled = true;
        els.icon.style.animation = "spin 900ms linear infinite";
      }
      try {
        const q = new URLSearchParams({
          lat: String(state.lat),
          lng: String(state.lng),
          cityId: CITY,
          limit: "8",
        });
        const data = await getJSON(`/api/nearby?${q}`);
        if (data.empty || !data.stations?.length) {
          els.list.innerHTML = "";
          els.msg.textContent = data.message || "附近没有查到线路，换个位置试试。";
        } else {
          render(data);
        }
        lastUpdated = Date.now();
      } catch (err) {
        els.msg.textContent = `查询失败：${err.message}`;
        els.msg.className = "msg err";
      } finally {
        state.busy = false;
        els.refresh.disabled = false;
        els.icon.style.animation = "";
      }
    }

    function locate() {
      els.status.textContent = "正在获取位置…";
      if (!navigator.geolocation) {
        state.lat = FALLBACK.lat;
        state.lng = FALLBACK.lng;
        els.status.textContent = FALLBACK.label;
        load();
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          state.lat = pos.coords.latitude;
          state.lng = pos.coords.longitude;
          load();
        },
        () => {
          state.lat = FALLBACK.lat;
          state.lng = FALLBACK.lng;
          els.status.textContent = FALLBACK.label + " · 未授权定位";
          load();
        },
        { timeout: 8000, maximumAge: 60_000 },
      );
    }

    els.refresh.addEventListener("click", () => load());
    onFavChange(renderFavs);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        renderFavs();
        if (Date.now() - lastUpdated > 20_000) load({ silent: true });
      }
    });

    renderFavs();
    locate();
    setInterval(() => {
      if (document.visibilityState === "visible") load({ silent: true });
    }, 30_000);
  </script>
</Base>
